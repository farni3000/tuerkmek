# Bot-Token von @BotFather (/newbot). Pflicht.
TELEGRAM_BOT_TOKEN=

# Optional: Telegram-User-IDs, die den Bot benutzen dürfen.
# Leer lassen – dann übernimmt der erste, der /start schickt.
TELEGRAM_ALLOWED_IDS=

# Zeitzone und Sendezeiten
TURKMEK_TZ=Europe/Berlin
TURKMEK_SLOTS=08:30,13:00,20:00

# Samstag/Sonntag aussetzen?
TURKMEK_WEEKEND_OFF=false

# Minuten nach einem Slot, in denen noch gesendet wird
TURKMEK_SLOT_WINDOW=15
